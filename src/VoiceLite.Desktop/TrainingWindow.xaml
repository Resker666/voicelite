<Window x:Class="VoiceLite.Desktop.TrainingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceLite · 训练新版本" Width="900" Height="780" MinWidth="800" MinHeight="700" Background="#F4F7FB" WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="训练新版本" FontSize="25" FontWeight="Bold"/>
      <TextBlock Text="使用已启用且逐字校对的素材，在本机 NVIDIA 显卡训练。每次新建独立版本，旧模型保留。" Foreground="#68788D" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
      <StackPanel><StackPanel IsEnabled="{Binding CanEdit}">
        <TextBlock Text="新版本名称" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="训练版本名称"/>
        <TextBlock Text="完整训练资源目录" Style="{StaticResource Label}"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="选择目录" Click="Engine_Click"/>
          <TextBox Text="{Binding EngineRoot}" IsReadOnly="True" AutomationProperties.Name="训练资源目录"/></DockPanel>
        <TextBlock Text="需要兼容的完整整合包和至少6 GiB可用空间；程序不会下载模型。" Foreground="#68788D" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel Margin="0,14,0,0"><Button Content="开始训练新版本" Click="Start_Click" IsEnabled="{Binding CanStart}" Background="#1676B6" Foreground="White"/>
        <Button Content="取消任务" Click="Cancel_Click" IsEnabled="{Binding IsBusy}"/>
        <TextBlock Text="固定8轮 · 完成后请试听比较" Foreground="#68788D" VerticalAlignment="Center" Margin="8,0,0,0"/></WrapPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanEdit}">
      <TextBlock Text="这个素材集的训练记录" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" DisplayMemberPath="DisplayName" AutomationProperties.Name="训练记录"/>
      <TextBlock Text="角色参考录音（3–10秒）" Style="{StaticResource Label}"/>
      <ComboBox ItemsSource="{Binding SelectedJob.References}" SelectedItem="{Binding SelectedReference}" DisplayMemberPath="DisplayName" AutomationProperties.Name="角色参考录音"/>
      <TextBlock Text="{Binding SelectedReference.Text}" TextWrapping="Wrap" MaxHeight="65" Foreground="#68788D" Margin="0,8,0,0"/>
      <WrapPanel Margin="0,14,0,0"><Button Content="保存角色包" Click="Export_Click" IsEnabled="{Binding CanExport}"/><Button Content="查看任务日志" Click="Logs_Click"/></WrapPanel>
      <TextBlock Text="保存后回主窗口点击“导入角色包”即可使用。新版本是否更像，需要用相同文案试听确认。" Foreground="#68788D" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding LastExportPath}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel></ScrollViewer></Border>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0"><StackPanel>
      <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
      <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Error}" Foreground="#B33939" TextWrapping="Wrap" Margin="0,7,0,0"/></ScrollViewer>
    </StackPanel></Border>
  </Grid>
</Window>
