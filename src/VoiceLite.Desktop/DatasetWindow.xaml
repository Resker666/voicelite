<Window x:Class="VoiceLite.Desktop.DatasetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceLite · 训练素材" Width="1120" Height="800" MinWidth="980" MinHeight="700" Background="#F4F7FB" WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="训练素材" FontSize="25" FontWeight="Bold"/><TextBlock Text="同一个声音放在同一素材集。先试听，再逐字校对；本窗口不开始模型训练。" Foreground="#68788D" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12" IsEnabled="{Binding CanEdit}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="DatasetList" ItemsSource="{Binding Datasets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDataset, Mode=OneWay}" SelectionChanged="Dataset_SelectionChanged" AutomationProperties.Name="素材集" Margin="0,0,12,0"/>
      <TextBox Grid.Column="1" Text="{Binding NewDatasetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="新素材集名称"/>
      <Button Grid.Column="2" Content="新建素材集" Click="Create_Click" Margin="10,0,0,0"/>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,0,0,12">
      <Expander Header="离线转写资源" IsEnabled="{Binding CanEdit}" Margin="0,0,0,10">
        <StackPanel Margin="0,8,0,0"><TextBlock Text="中文自动转写使用本机CPU。请选择已包含离线转写模型的整合包，程序不会下载模型。" Foreground="#68788D" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="选择资源目录" Click="SelectAsr_Click"/><TextBox Text="{Binding AsrEngineRoot}" IsReadOnly="True" AutomationProperties.Name="转写资源目录"/></DockPanel>
        </StackPanel>
      </Expander>
      <WrapPanel>
        <Button Content="批量导入录音" Click="Import_Click" IsEnabled="{Binding CanOperateDataset}" Margin="0,0,8,4"/>
        <Button Content="自动转写空白项" Click="Transcribe_Click" IsEnabled="{Binding CanOperateDataset}" Margin="0,0,8,4"/>
        <Button Content="保存校对" Click="Save_Click" IsEnabled="{Binding CanOperateDataset}" Margin="0,0,8,4"/>
        <Button Content="重新载入" Click="Reload_Click" IsEnabled="{Binding CanOperateDataset}" Margin="0,0,8,4"/>
        <Button Content="导出训练集" Click="Export_Click" IsEnabled="{Binding CanOperateDataset}" Margin="0,0,0,4"/>
        <Button Content="训练新版本" Click="Train_Click" IsEnabled="{Binding CanOperateDataset}" Margin="8,0,0,4"/>
      </WrapPanel>
      <TextBlock Text="{Binding Summary}" Foreground="#68788D" Margin="0,6,0,0"/>
    </StackPanel>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListView ItemsSource="{Binding Clips}" SelectedItem="{Binding SelectedClip}" SelectionChanged="Clip_SelectionChanged" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="训练录音列表">
        <ListView.View><GridView><GridViewColumn Header="录音" Width="225" DisplayMemberBinding="{Binding SourceName}"/><GridViewColumn Header="时长" Width="65" DisplayMemberBinding="{Binding Duration}"/><GridViewColumn Header="状态" Width="75" DisplayMemberBinding="{Binding Status}"/></GridView></ListView.View>
      </ListView>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" IsEnabled="{Binding CanEditClip}" Margin="0,10,0,0">
            <WrapPanel><CheckBox Content="纳入训练" IsChecked="{Binding SelectedClip.Included}" Margin="0,0,20,0"/><CheckBox Content="已听音并逐字校对" IsChecked="{Binding SelectedClip.Reviewed}" IsEnabled="{Binding SelectedClip.CanReview}"/></WrapPanel>
            <TextBlock Text="修改文字或语言后，会取消已校对标记。导出只包含已启用且已校对的片段。" Foreground="#68788D" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanEditClip}">
          <TextBlock Text="{Binding SelectedClip.SourceName}" FontWeight="Bold" TextWrapping="Wrap"/>
          <Button Content="试听选中录音" Click="Play_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
          <TextBlock Text="录音中实际说了什么" Style="{StaticResource Label}"/>
          <TextBox Text="{Binding SelectedClip.Text, UpdateSourceTrigger=PropertyChanged}" Height="135" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="2000" AutomationProperties.Name="素材文字"/>
          <TextBlock Text="自动转写仅为草稿。请听完整段录音，逐字检查；不要填写背景人声或没有说出的内容。" Foreground="#886720" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <TextBlock Text="录音语言" Style="{StaticResource Label}"/>
          <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding SelectedClip.Language}" AutomationProperties.Name="素材语言"/>
          </StackPanel></ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0">
      <StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="取消任务" Click="Cancel_Click" IsEnabled="{Binding IsBusy}"/><TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
        <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Error}" Foreground="#B33939" TextWrapping="Wrap" Margin="0,6,0,0"/></ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>
</Window>
